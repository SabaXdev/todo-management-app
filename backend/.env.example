# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Database (PostgreSQL)
# Use 127.0.0.1 for local dev on Windows: "localhost" often resolves to IPv6 (::1)
# first; if Postgres only listens on IPv4, you will see ECONNREFUSED ::1:5432.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=todo_management
DATABASE_SYNC=true
# Set to true for Neon and other managed Postgres hosts that require SSL
DATABASE_SSL=false

# JWT
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Bcrypt
BCRYPT_SALT_ROUNDS=10
